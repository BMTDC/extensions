<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.thomasdc.sifoinsightmatrix" extension-version="1.0.5">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Operational SIFO productivity overview with KPI context, configurable target, ranking and automatic insights.</description>
    <author name="Thomas De Ceuster" email="thomas.deceuster@bleckmann.com" organization="Bleckmann" website="https://www.bleckmann.com"/>
    <min-api-version>1.14</min-api-version>
    <source-location>
      <url>https://bmtdc.github.io/extensions/sifo-insight-matrix/</url>
    </source-location>
    <icon/>
    <context-menu>
      <configure-context-menu-item/>
    </context-menu>
    <encoding id="date">
      <display-name resource-id="date-name">Date</display-name>
      <data-spec><data-type>temporal</data-type></data-spec>
      <role-spec><role-type>continuous-dimension</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-d"/>
      <tooltip>Date range used for the current view.</tooltip>
    </encoding>
    <encoding id="group">
      <display-name resource-id="group-name">Group</display-name>
      <role-spec><role-type>discrete-dimension</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-g"/>
      <tooltip>Dimension used to split productivity into groups.</tooltip>
    </encoding>
    <encoding id="productivity">
      <display-name resource-id="productivity-name">Productivity</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <role-spec><role-type>continuous-measure</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-p"/>
      <tooltip>Productivity measure displayed and compared with the configured target.</tooltip>
    </encoding>
    <encoding id="volume">
      <display-name resource-id="volume-name">Volume</display-name>
      <data-spec><data-type>numeric</data-type></data-spec>
      <role-spec><role-type>continuous-measure</role-type></role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-v"/>
      <tooltip>Optional volume measure used to weight productivity.</tooltip>
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name"><text locale="en_US">SIFO Insight Matrix</text></resource>
    <resource id="date-name"><text locale="en_US">Date (optional)</text></resource>
    <resource id="group-name"><text locale="en_US">Group</text></resource>
    <resource id="productivity-name"><text locale="en_US">Productivity</text></resource>
    <resource id="volume-name"><text locale="en_US">Volume (optional)</text></resource>
  </resources>
</manifest>
